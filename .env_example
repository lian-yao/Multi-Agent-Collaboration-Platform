# 复制为 .env 使用（.env 已在 .gitignore 中，不会入库）。
# 模型接入见 doc/decisions/014-api-first-model-access.md：
# 默认走 OpenAI 兼容 API，本地 Ollama 通过 AGENT_LLM_PROVIDER=ollama 回退。

# 模型提供方：openai（默认）或 ollama
AGENT_LLM_PROVIDER=openai
AGENT_OPENAI_MODEL=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen2.5-coder:7b
AGENT_TEMPERATURE=0.2

# 存储
REDIS_URL=redis://localhost:6380/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/multi_agent

# ---------------------------------------------------------------------------
# 工具（app/tools，前缀 TOOL_）
# ---------------------------------------------------------------------------
# 网络搜索的**出口实现**（ADR-037）：
# - duckduckgo（默认）：DuckDuckGo Instant Answer 契约；该域名在部分网络被阻断（实测宿主
#   机与容器都连不通），一键部署时 compose 会把 backend 指向同网络的 search-gateway
#   （Bing RSS → 同一契约，见 scripts/search_gateway.py 与 ADR-032）。
# - volcengine：火山引擎豆包搜索 Custom（POST + Bearer key，按量付费）。选它就不需要额外
#   进程，也不占 EGRESS_INTERNAL_HOSTS / 端口白名单——本地直跑后端时最省事。
TOOL_SEARCH_PROVIDER=duckduckgo
# 端点不写就按 provider 取默认（volcengine → open.feedcoopapi.com/search_api/web_search）；
# 要指向本地网关或自建服务时再显式覆盖。
# TOOL_SEARCH_ENDPOINT=http://127.0.0.1:8800/search
# provider=volcengine 时必填；空值直接报配置错，不会发出无鉴权请求。
# TOOL_SEARCH_API_KEY=
TOOL_SEARCH_TIMEOUT_SECONDS=8
TOOL_SEARCH_MAX_RESULTS=5

# 只读 SQL：DSN 留空时用上面的 DATABASE_URL；
# 入参没给 limit 时用 TOOL_SQL_DEFAULT_LIMIT（硬上限 500 行）。
TOOL_SQL_DSN=
TOOL_SQL_TIMEOUT_SECONDS=5
TOOL_SQL_DEFAULT_LIMIT=50

# ---------------------------------------------------------------------------
# MCP（app/mcp，前缀 MCP_）
# ---------------------------------------------------------------------------
# 流水线的工具接入方式：inprocess（默认，进程内）/ stdio（子进程）/ http（已部署的 Server）
MCP_TRANSPORT=inprocess
MCP_SERVER_NAME=macp-tools
# stdio 模式下的可执行文件；留空使用当前解释器
MCP_SERVER_COMMAND=
# http 模式的目标地址
MCP_SERVER_URL=http://localhost:8081/mcp
MCP_CALL_TIMEOUT_SECONDS=30
# 是否把「配置页注册并发现过的 MCP Server」的工具并入流水线工具注册表。
# 默认 false：开启后读取注册条目会连一次配置库（有界超时，失败即忽略）。
# 注意开启后 GET /api/v1/tools 的目录会随用户注册的 Server 变化。
MCP_INCLUDE_REGISTERED_SERVERS=false

# ---------------------------------------------------------------------------
# 出网策略（app/security，前缀 EGRESS_，ADR-034）
# ---------------------------------------------------------------------------
# 只放公网地址：内网（10/172.16-31/192.168）、回环、链路本地（含云元数据）、CGNAT
# 与 IPv6 保留段一律拦截。非法配置会**拒绝启动**，不做"跳过这条"的宽容处理。
EGRESS_MODE=public_only
# allowlist 模式下的域名白名单；deny 优先于 allow。支持精确主机名与 `*.` 前缀通配。
EGRESS_ALLOW_HOSTS=
EGRESS_DENY_HOSTS=
# 平台内部依赖的精确主机名（compose 服务名），豁免私网判定——放行的是**列出的服务**。
EGRESS_INTERNAL_HOSTS=
# 允许的端口；内网服务要显式加端口，豁免私网判定不等于豁免端口。
EGRESS_ALLOWED_PORTS=443
# 模型流量是否豁免私网判定（Ollama / 内网自建网关）；豁免的只是私网判定，
# scheme / 端口 / 域名黑名单照常生效。
EGRESS_MODEL_EXEMPT=true

# ---------------------------------------------------------------------------
# 工具沙箱（app/sandbox，前缀 SANDBOX_）
# ---------------------------------------------------------------------------
# backend 取值：docker（默认，容器隔离）/ denied（一律拒绝执行）。
# 用 docker 时必须让后端进程能访问 Docker 守护进程：
#   - 本机直接跑：有 Docker Desktop / dockerd 即可；
#   - 容器里跑（deploy/compose.yaml）：需要挂载 /var/run/docker.sock，
#     否则 code_execution 工具会以「沙箱不可用」失败（不会降级到宿主机执行）。
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK_ENABLED=false
SANDBOX_OUTPUT_LIMIT_CHARS=4000
SANDBOX_MAX_CODE_CHARS=20000

# ---------------------------------------------------------------------------
# 可观测（app/observability，前缀 OBS_）
# ---------------------------------------------------------------------------
# 链路追踪：端点默认与 deploy/compose.yaml 的 jaeger（OTLP HTTP 4318）一致；
# 关闭后 span 全部退化为空操作，业务代码不需要改。
OBS_SERVICE_NAME=macp-backend
OBS_TRACING_ENABLED=true
OBS_TRACING_ENDPOINT=http://localhost:4318/v1/traces
OBS_TRACING_SAMPLE_RATIO=1.0
OBS_TRACING_EXPORT_TIMEOUT_SECONDS=5
# 指标采样落库方式：postgres（默认，写 metrics 表，表不存在时跳过）/ none（关闭）
OBS_METRICS_ENABLED=true
OBS_METRICS_SINK=postgres
OBS_METRICS_FLUSH_SIZE=50
OBS_METRICS_DEDUPE_LIMIT=5000
