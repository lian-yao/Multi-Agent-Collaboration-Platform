# 复制为 .env 使用（.env 已在 .gitignore 中，不会入库）。
# 模型接入见 doc/decisions/014-api-first-model-access.md：
# 默认走 OpenAI 兼容 API，本地 Ollama 通过 AGENT_LLM_PROVIDER=ollama 回退。

# 模型提供方：openai（默认）或 ollama
AGENT_LLM_PROVIDER=openai
AGENT_OPENAI_MODEL=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen2.5-coder:7b
AGENT_TEMPERATURE=0.2

# 配置写接口令牌（doc/api.md §5.7、§5.8）。留空表示写接口一律 403。
ADMIN_TOKEN=

# 存储
REDIS_URL=redis://localhost:6380/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/multi_agent
